    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: endDialogue.Array.data[0].sentence
      value: "Leciutka rozg\u017Cewka i co padacie?"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[0].sentence
      value: "Do mnie!! U mnie si\u0119 zasuwa!"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[1].sentence
      value: 'Ojej! Ja? Do Pana? Ale... ale o co chodzi? Kim Pan jest? '
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[2].sentence
      value: "Ale u mnie sie tak zasuwa, \u017Ce nigdzie si\u0119 tak nie zasuwa
        jak u mnie. Zrozumiano? "
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[3].sentence
      value: Ale kim Pan jest?
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[4].sentence
      value: "S\u0142abi musz\u0105 si\u0119 zajecha\u0107 aby silni mogli przetrwa\u0107! "
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[5].sentence
      value: "Ale \u015Bwir. Mo\u017Ce lepiej Pana zostawie tutaj."
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[0].sentence
      value: "Do mnie!! U mnie si\u0119 zasuwa!"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[1].sentence
      value: Ojej! Ja? Do Pana? Ale... ale o co chodzi? Kim Pan jest?
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[2].sentence
      value: "Ale u mnie si\u0119 tak zasuwa, \u017Ce nigdzie si\u0119 tak nie zasuwa
        jak u mnie. Zrozumiano?"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[3].sentence
