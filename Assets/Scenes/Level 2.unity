    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: player
      value: 
      objectReference: {fileID: 1205547531}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: useEndDialogue
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: endDialogue.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: endDialogue.Array.data[0].sentence
      value: "Jeszcze troche si\u0119 tutaj rozejrze."
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[0].sentence
      value: "Eee... cze\u015B\u0107! Ja... ten... d-dzie\u0144 dobry?"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[1].sentence
      value: "Hej. Wszystko z tob\u0105 okej? Wygl\u0105dasz, jakby\u015B zaraz mia\u0142
        zemdle\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[2].sentence
      value: "T-tak! Wszystko super! Szu-szukasz tu czego\u015B w trawie?"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[3].sentence
      value: "Kluczy. Prof. Gabry\u015B zn\xF3w nabroi\u0142. Nasika\u0142 jednemu
        z prowadz\u0105cych prosto do but\xF3w i za kar\u0119 siedzi w klatce na
        ko\u0144cu lasu. Zamkn\u0119li go na trzy spusty, a klucze rozrzucili po
        okolicy. Nie widzia\u0142e\u015B ich?"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[4].sentence
      value: "Nie widzia\u0142em, ale znajd\u0119 je wszystkie i uwolni\u0119 Gabrysia,
        obiecuj\u0119! A jak mi si\u0119 uda... to mo\u017Ce... p\xF3jdziesz ze mn\u0105
        na randk\u0119?"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[5].sentence
      value: "Odwa\u017Cnie. Najpierw znajd\u017A kota, \"bohaterze\". Potem pomy\u015Bl\u0119."
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[6].sentence
      value: "Stoi! Ju\u017C biegn\u0119!"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: mainDialogue.Array.data[7].sentence
      value: "Tylko si\u0119 nie przewr\xF3\u0107 o w\u0142asny ogon!"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[0].sentence
      value: "Eee... cze\u015B\u0107! Ja... ten... d-dzie\u0144 dobry?"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[1].sentence
      value: "Hej. Wszystko z tob\u0105 okej? Wygl\u0105dasz, jakby\u015B zaraz mia\u0142
        zemdle\u0107."
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[2].sentence
      value: "T-Tak! Suuuper! Szu..Szukasz tu czego\u015B? "
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[3].sentence
      value: "Kota. Zgin\u0105\u0142 mi Garby\u015B. Szary z bia\u0142ymi \u0142apkami,
        puszysty i lekko utyty. Widzia\u0142e\u015B go?? "
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[4].sentence
      value: "Nie, ale znajd\u0119 go! Obiecuj\u0119! I... wtedy... p\xF3jdziesz
        ze mn\u0105 na randk\u0119?"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[5].sentence
      value: "Odwa\u017Cnie. Najpierw znajd\u017A kota, \"bohaterze\". Potem pomy\u015Bl\u0119."
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[6].sentence
      value: "Stoi! Ju\u017C biegn\u0119!"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: dialogueLines.Array.data[7].sentence
      value: "Tylko si\u0119 nie przewr\xF3\u0107 o w\u0142asny ogon!"
      objectReference: {fileID: 0}
    - target: {fileID: 4966462533120437641, guid: 9e423815e9dc3c548946e66810fa327e, type: 3}
      propertyPath: endDialogue.Array.data[0].speakerName
      value: "Kr\xF3lica"
      objectReference: {fileID: 0}
